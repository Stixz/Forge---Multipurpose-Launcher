:root {
    --bg-1: #1a0f08;
    --bg-2: #3a2014;
    --glass: rgba(255, 255, 255, 0.07);
    --surface-header: #3a2014dd;
    --surface-panel: #3a2014f2;
    --surface-panel-strong: #3a2014f5;
    --line: rgba(255, 255, 255, 0.18);
    --text: #f7eee3;
    --text-soft: #d9c8b2;
    --accent: #ff7a1a;
    --accent-2: #ffb167;
    --hover-glow: #ffb167;
    --tile-glow: #ffb1675c;
    --tile-min: 165px;
    --tile-min-height: 132px;
}

* {
    box-sizing: border-box;
}

html {
    scrollbar-width: none;
    -ms-overflow-style: none;
}

html::-webkit-scrollbar {
    display: none;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: "Segoe UI", "Trebuchet MS", sans-serif;
    color: var(--text);
    scrollbar-width: none;
    -ms-overflow-style: none;
    background:
        /* Ember glow removed for all themes */
        linear-gradient(150deg, var(--bg-1), var(--bg-2));
}

:root {
    --shell-padding: 20px;
    --rail-spacing: 10px;
    --rail-width: 188px;
    --content-margin: calc(var(--shell-padding) + var(--rail-spacing));
}

body::-webkit-scrollbar {
    display: none;
}

.launcher-shell {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px;
    padding-top: 90px;
    transition: filter 0.2s ease, transform 0.2s ease, opacity 0.2s ease;
    transform-origin: center top;
    scrollbar-width: none;
    -ms-overflow-style: none;
}

.launcher-shell::-webkit-scrollbar {
    display: none;
}

body.settings-open .launcher-shell {
    filter: none;
}

.topbar {
    position: fixed;
    top: 20px;
    /* left: 120px; */
    right: 220px;
    width: 72%;
    z-index: 30;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px;
    border: 1px solid var(--line);
    background: var(--surface-header);
    border-radius: 16px;
    backdrop-filter: blur(14px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
}

.brand h1 {
    margin: 0;
    font-size: 1.7rem;
    letter-spacing: 0.04em;
}

.brand p {
    margin: 4px 0 0;
    color: var(--text-soft);
    font-size: 0.9rem;
}

.title-drag-spacer {
    flex: 1;
    min-width: 40px;
    height: 28px;
    margin: 0 10px;
}

.actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.profile-dropdown-wrapper {
    position: relative;
}

.profile-dropdown-btn {
    padding: 8px 12px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.12);
    color: var(--text);
    cursor: pointer;
    font-size: 0.9rem;
    min-width: 120px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
}

.profile-dropdown-btn:hover {
    border-color: var(--hover-glow);
}

.dropdown-arrow {
    font-size: 0.7rem;
    opacity: 0.7;
}

.profile-dropdown-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    min-width: 140px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-panel);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    z-index: 100;
}

.profile-option {
    width: 100%;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    padding: 8px 12px;
    text-align: left;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s ease;
}

.profile-option:hover {
    background: rgba(245, 165, 36, 0.2);
}

.profile-option.active {
    background: rgba(245, 165, 36, 0.3);
}

.topbar .brand,
.topbar .brand *,
.topbar .actions,
.topbar .actions * {
    -webkit-app-region: no-drag;
}

.btn {
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.12);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 10px;
    cursor: pointer;
}

.btn:hover {
    transform: translateY(-1px);
    border-color: var(--hover-glow);
}

.ghost {
    background: transparent;
}

.launcher-main {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    align-items: start;
}

.launcher-content {
    min-width: 0;
    margin-left: auto;
    margin-right: var(--shell-padding);
    max-width: 790px;
    padding-top: 20px;
    scrollbar-width: none;
    -ms-overflow-style: none;
    mask-image: linear-gradient(to bottom, transparent 0px, black 80px);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0px, black 80px);
}

.launcher-content::-webkit-scrollbar {
    display: none;
}

.category-rail {
    position: fixed;
    top: 130px;
    left: calc(var(--shell-padding) + 185px);
    width: var(--rail-width);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.05);
    padding: var(--rail-spacing);
    display: grid;
    gap: 6px;
    max-height: calc(100vh - 160px);
    overflow-y: auto;
}

.category-filter-btn {
    width: 100%;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-soft);
    border-radius: 10px;
    padding: 8px 10px;
    cursor: pointer;
    text-align: left;
    font-size: 0.84rem;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
}

.category-filter-btn:hover {
    border-color: var(--hover-glow);
    color: var(--text);
}

.category-filter-btn.active {
    border-color: var(--accent);
    color: var(--text);
    background: rgba(245, 165, 36, 0.18);
}

.search-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
}

.search-input {
    flex: 1;
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    padding: 9px 10px;
}

.search-input::placeholder {
    color: var(--text-soft);
}

.quick-tips {
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.quick-tips p {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.88rem;
}

.grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--tile-min), 1fr));
    gap: 12px;
}

.app-tile * {
    pointer-events: none;
}

.tile-health-fix-btn {
    pointer-events: auto;
    margin-top: 10px;
    border: 1px solid rgba(255, 190, 78, 0.58);
    border-radius: 8px;
    background: rgba(255, 122, 26, 0.16);
    color: #ffe7c1;
    font-size: 0.74rem;
    padding: 4px 8px;
    cursor: pointer;
}

.tile-health-fix-btn:hover,
.tile-health-fix-btn:focus-visible {
    border-color: var(--hover-glow);
    background: rgba(255, 122, 26, 0.24);
    color: #fff3de;
}

/* ── Config backup restore list ─────────────────────────────────── */
.backup-list {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-bottom: 10px;
    max-height: 260px;
    overflow-y: auto;
    padding-right: 2px;
}

.backup-entry {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
}

.backup-label {
    flex: 1;
    font-size: 0.82rem;
    color: var(--text-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.backup-size {
    font-size: 0.74rem;
    color: var(--text-soft);
    opacity: 0.6;
    white-space: nowrap;
}

.backup-empty {
    font-size: 0.82rem;
    color: var(--text-soft);
    opacity: 0.6;
    margin: 0;
    padding: 8px 0;
}

.app-tile.tile-dragging {
    opacity: 0.5;
}

.tile-dragging-copy {
    opacity: 0.7;
    box-shadow: 0 0 0 2px rgba(245, 165, 36, 0.5);
}

.app-tile.tile-drag-over {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
}

.app-tile.tile-drag-over-copy {
    border-color: rgba(245, 165, 36, 0.8);
    box-shadow: 0 0 0 2px rgba(245, 165, 36, 0.6);
}

.app-tile--broken {
    border-color: rgba(239, 68, 68, 0.55);
}

.app-tile--broken:hover {
    border-color: rgba(239, 68, 68, 0.85);
    box-shadow: 0 0 0 1px rgba(239, 68, 68, 0.4);
}

.tile-broken-badge {
    font-size: 0.85rem;
    line-height: 1;
    margin-left: auto;
}

.app-tile {
    position: relative;
    z-index: 1;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: linear-gradient(160deg, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0.03));
    border-radius: 14px;
    padding: 14px;
    min-height: var(--tile-min-height);
    cursor: pointer;
    overflow: visible;
    transition: transform 0.2s ease, border-color 0.2s ease;
}

.app-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(circle at var(--x, 50%) var(--y, 50%), var(--tile-glow), transparent 52%);
    opacity: 0;
    transition: opacity 0.25s ease;
}

.app-tile::after {
    content: attr(data-tip);
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: calc(100% + 8px);
    z-index: 4;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(8, 18, 30, 0.96);
    color: var(--text);
    font-size: 0.72rem;
    line-height: 1.25;
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.16s ease, transform 0.16s ease;
}

.app-tile:hover {
    transform: translateY(-3px);
    border-color: var(--hover-glow);
}

.app-tile:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
}

.app-tile:hover::before {
    opacity: 1;
}

body.tile-tips-enabled .app-tile:hover::after {
    opacity: 1;
    transform: translateY(0);
}

.bottombar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    text-align: center;
    padding: 0.5rem 0;
    background: var(--surface-1); /* optional */
}

.tile-header,
.tile-footer {
    position: relative;
    z-index: 1;
}

.tile-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.icon {
    font-size: 1.5rem;
}

.type-pill {
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 0.68rem;
    text-transform: uppercase;
    color: var(--accent-2);
}

.name {
    position: relative;
    z-index: 1;
    margin-top: 14px;
    font-size: 1rem;
    font-weight: 600;
}

.desc {
    position: relative;
    z-index: 1;
    margin: 6px 0 0;
    color: var(--text-soft);
    font-size: 0.82rem;
}

#app-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.empty-state {
    margin: 0;
    color: var(--text-soft);
    border: 1px dashed var(--line);
    border-radius: 12px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.05);
}

.category-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.category-heading {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-2);
    padding-bottom: 6px;
    border-bottom: 1px solid var(--line);
}

.window-controls {
    display: flex;
    gap: 6px;
}

.window-btn {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    cursor: pointer;
}

.modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    background:
        /* Ember and blue glow removed for all themes */
        rgba(8, 12, 18, 0.34);
    backdrop-filter: blur(12px) saturate(1.02);
}

.modal-content {
    width: min(440px, 92vw);
    max-height: 88vh;
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 16px;
    border: 1px solid var(--line);
    background: var(--surface-panel);
    padding: 16px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255,255,255,0.2) transparent;
}

.modal-content h2 {
    margin: 0 0 12px;
}

.settings-notice {
    position: sticky;
    top: -1px;
    z-index: 2;
    margin: 0 0 12px;
    padding: 10px 12px;
    border: 1px solid rgba(255, 227, 162, 0.34);
    border-radius: 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(245, 165, 36, 0.1));
    color: #ffe8ba;
    font-size: 0.84rem;
    line-height: 1.4;
    backdrop-filter: blur(10px);
}

.settings-content {
    width: min(980px, 96vw);
}

.settings-shell {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
}

.settings-tabs {
    position: sticky;
    top: 0;
    display: grid;
    gap: 6px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    padding: 8px;
}

.settings-tab-btn {
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 8px 10px;
    background: transparent;
    color: var(--text-soft);
    text-align: left;
    cursor: pointer;
    font-size: 0.86rem;
}

.settings-tab-btn:hover {
    border-color: var(--line);
    color: var(--text);
}

.settings-tab-btn:focus-visible {
    outline: none;
    border-color: var(--accent-2);
    box-shadow: 0 0 0 2px rgba(245, 165, 36, 0.26);
    color: var(--text);
}

.settings-tab-btn.active {
    border-color: var(--accent-2);
    background: rgba(245, 165, 36, 0.24);
    box-shadow: inset 0 0 0 1px rgba(255, 227, 162, 0.24);
    color: var(--text);
}

.settings-panels {
    min-width: 0;
}

.settings-panel {
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 8px 18px rgba(0, 0, 0, 0.12);
    padding: 12px;
}

.settings-panel .section-title:first-child {
    margin-top: 0;
}

.help-content {
    width: min(560px, 94vw);
}

.command-palette-content {
    width: min(620px, 95vw);
}

.command-palette-results {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
    max-height: 320px;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
}

.command-palette-item {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: transparent;
    color: var(--text);
    text-align: left;
    cursor: pointer;
}

.command-palette-item:last-child {
    border-bottom: 0;
}

.command-palette-item:hover,
.command-palette-item.active {
    background: rgba(245, 165, 36, 0.16);
}

.command-palette-item .icon {
    font-size: 1.05rem;
}

.command-palette-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.command-palette-title {
    font-size: 0.9rem;
    font-weight: 600;
}

.command-palette-meta {
    margin-top: 2px;
    color: var(--text-soft);
    font-size: 0.76rem;
}

.command-palette-empty {
    margin: 0;
    padding: 12px;
    color: var(--text-soft);
    font-size: 0.84rem;
}

.pin-content {
    width: min(360px, 92vw);
}

.pin-note {
    margin: 0 0 10px;
    color: var(--text-soft);
    font-size: 0.88rem;
}

.field-note {
    font-size: 0.8rem;
    font-weight: normal;
    opacity: 0.6;
}

.pin-error {
    margin: 10px 0 0;
    color: #ffb1b1;
    font-size: 0.84rem;
}

.help-list {
    margin: 0;
    padding-left: 18px;
    color: var(--text-soft);
    line-height: 1.5;
}

.help-content .section-title {
    margin-top: 16px;
}

.help-content .section-title:first-of-type {
    margin-top: 0;
}

.help-list li {
    margin-top: 6px;
}

.import-preview-summary {
    margin: 0 0 14px;
    color: var(--text-soft);
    line-height: 1.5;
}

.import-preview-breakdown {
    margin: 0 0 12px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.45;
}

.import-preview-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
}

.import-preview-card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.04);
}

.import-preview-card h3 {
    margin: 0 0 6px;
    color: var(--accent-2);
    font-size: 0.9rem;
    text-transform: uppercase;
}

.import-preview-card p {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.45;
}

.import-preview-section {
    margin-top: 14px;
}

.import-preview-list {
    max-height: 180px;
    overflow: auto;
    padding-right: 6px;
}

.import-preview-item {
    margin-top: 8px;
    padding: 7px 9px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    list-style-position: inside;
}

.import-preview-item-add {
    border-color: rgba(105, 220, 142, 0.45);
    color: #a9f3bd;
    background: rgba(74, 162, 103, 0.14);
}

.import-preview-item-merge {
    border-color: rgba(245, 165, 36, 0.45);
    color: #ffd89a;
    background: rgba(245, 165, 36, 0.14);
}

.section-title {
    margin: 14px 0 4px;
    color: var(--accent-2);
    font-size: 0.95rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
}

.section-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    user-select: none;
}

.section-toggle:hover {
    color: var(--accent);
}

.toggle-chevron {
    font-size: 0.8rem;
    transition: transform 0.2s ease;
}

.modal-content label {
    display: block;
    margin-top: 10px;
    font-size: 0.92rem;
}

.inline-toggle {
    display: flex !important;
    align-items: center;
    gap: 8px;
    color: var(--text-soft);
}

.modal-content input,
.modal-content select {
    width: 100%;
    margin-top: 5px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.08);
    color: var(--text);
    padding: 8px;
}

.modal-content select option {
    background: var(--surface-panel);
    color: var(--text);
}

.modal-content input[type="color"] {
    padding: 2px;
    height: 34px;
    cursor: pointer;
}

.modal-content input[type="checkbox"] {
    width: auto;
    margin-top: 0;
    margin-right: 2px;
    padding: 0;
    accent-color: var(--accent);
}

.color-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
}

.row-input {
    display: flex;
    gap: 8px;
}

.custom-size-controls {
    margin-top: 8px;
    padding: 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
}

.theme-preset-list {
    margin-top: 10px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 8px;
}

.theme-preset-empty {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.8rem;
    padding: 8px 10px;
    border: 1px dashed var(--line);
    border-radius: 10px;
}

.theme-preset-thumb {
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.03);
    color: var(--text);
    padding: 8px;
    cursor: pointer;
    text-align: left;
    display: grid;
    gap: 7px;
}

.theme-preset-thumb:hover {
    border-color: var(--hover-glow);
}

.theme-preset-thumb:focus-visible {
    outline: none;
    border-color: var(--hover-glow);
    box-shadow: 0 0 0 2px rgba(255, 177, 103, 0.45);
}

.theme-preset-thumb.active {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(255, 122, 26, 0.35);
}

.theme-preset-preview {
    display: block;
    height: 34px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background:
        radial-gradient(circle at 76% 28%, var(--p-accent), transparent 28%),
        radial-gradient(circle at 20% 74%, var(--p-hover), transparent 30%),
        linear-gradient(145deg, var(--p-bg1), var(--p-bg2));
}

.theme-preset-name {
    display: block;
    font-size: 0.78rem;
    color: var(--text-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.custom-size-row {
    display: flex;
    align-items: center;
    gap: 10px;
}

.custom-size-row input[type="range"] {
    flex: 1;
    margin-top: 0;
}

.size-value {
    min-width: 52px;
    text-align: right;
    font-size: 0.8rem;
    color: var(--text-soft);
}

.app-editor-error {
    margin: 12px 0 0;
    padding: 10px 12px;
    border: 1px solid rgba(255, 126, 126, 0.38);
    border-radius: 10px;
    background: rgba(180, 38, 38, 0.14);
    color: #ffd2d2;
    font-size: 0.84rem;
    line-height: 1.4;
}

.split-actions {
    justify-content: space-between;
}

.settings-action-groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
}

.action-group {
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
}

.action-group-title {
    margin: 0 0 8px;
    color: var(--accent-2);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.action-group-right {
    margin-top: 12px;
}

.settings-sticky-bar {
    position: sticky;
    bottom: -1px;
    z-index: 4;
    background: var(--surface-panel-strong);
    backdrop-filter: blur(12px);
    box-shadow: 0 -8px 18px rgba(0, 0, 0, 0.18);
}

.actions-left,
.actions-right {
    display: flex;
    gap: 8px;
}

.left-actions {
    justify-content: flex-start;
}

.editor-actions {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 16px;
}

.action-group .editor-actions {
    margin-top: 0;
}

.hidden {
    display: none !important;
}

.toast-region {
    position: fixed;
    right: 16px;
    bottom: 56px;
    z-index: 1200;
    display: grid;
    gap: 8px;
    width: min(380px, calc(100vw - 24px));
}

.toast {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgba(9, 20, 33, 0.93);
    color: var(--text);
    padding: 10px 12px;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(10px);
    animation: toast-in 0.16s ease-out;
}

.toast-success {
    border-color: rgba(105, 220, 142, 0.45);
}

.toast-info {
    border-color: rgba(245, 165, 36, 0.45);
}

.toast-warning {
    border-color: rgba(255, 190, 78, 0.6);
    background: rgba(56, 40, 8, 0.93);
}

.toast-error {
    border-color: rgba(255, 132, 132, 0.62);
    background: rgba(58, 16, 20, 0.93);
}

.context-menu {
    position: fixed;
    z-index: 2000;
    min-width: 160px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface-panel);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.ctx-menu-item {
    width: 100%;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text);
    padding: 8px 12px;
    text-align: left;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background 0.15s ease;
}

.ctx-menu-item:hover {
    background: rgba(245, 165, 36, 0.2);
}

.ctx-menu-item:focus-visible {
    outline: none;
    background: rgba(245, 165, 36, 0.2);
    box-shadow: 0 0 0 2px rgba(245, 165, 36, 0.4);
}

/* Animation */
@keyframes toast-in {
    from {
        opacity: 0;
        transform: translateY(6px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Body styling */
body {
    min-height: 100vh;
    font-family: "Segoe UI", "Trebuchet MS", sans-serif;
    color: var(--text);
    background:
        radial-gradient(circle at 84% 10%, rgba(147, 234, 255, 0.2), transparent 42%),
        linear-gradient(150deg, var(--bg-1), var(--bg-2));
}

/* Toast container? (guessing based on your properties) */
.toast {
    position: fixed;
    left: 0;
    width: 100%;
    padding: 10px 0;
    text-align: center;
    background: linear-gradient(to top, rgba(4, 10, 16, 0.6), transparent);
    pointer-events: none;
    animation: toast-in 0.25s ease-out;
}

.footer-text {
    margin: 0;
    font-size: 0.78rem;
    color: var(--text-soft);
}

.drag-region {
    -webkit-app-region: drag;
}

.no-drag {
    -webkit-app-region: no-drag;
}

.resize-grip {
    position: fixed;
    bottom: 0;
    right: 0;
    width: 18px;
    height: 18px;
    cursor: nwse-resize;
    -webkit-app-region: no-drag;
    z-index: 9999;
    /* subtle triangular visual cue */
    background: linear-gradient(135deg, transparent 50%, rgba(255,255,255,0.18) 50%);
    border-bottom-right-radius: 4px;
}

@media (max-width: 920px) {
    .launcher-shell {
        padding: 14px;
    }

    .topbar {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .actions {
        width: 100%;
        justify-content: space-between;
    }

    .launcher-main {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .category-rail {
        position: static;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        overflow-x: auto;
        padding: 8px;
    }

    .category-filter-btn {
        width: auto;
        white-space: nowrap;
    }

    .quick-tips {
        flex-direction: column;
        align-items: flex-start;
    }

    .import-preview-grid {
        grid-template-columns: 1fr;
    }

    .settings-shell {
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .settings-tabs {
        position: static;
        display: flex;
        flex-wrap: wrap;
    }

    .settings-tab-btn {
        white-space: nowrap;
    }

    .settings-action-groups {
        grid-template-columns: 1fr;
    }

    .action-group-right {
        grid-column: auto;
    }
}
